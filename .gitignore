# No trailing slash: `node_modules/` matches only real directories, so the
# node_modules SYMLINK that PARALLEL_PROTOCOL's worktree setup creates was
# trackable by `git add -A` (bit WP-04; caught and reverted in 1db0d2a9).
node_modules
lib/
coverage/
dist/
models/all-MiniLM-L6-v2-quantized/model.onnx
models/all-MiniLM-L6-v2-quantized/vocab.txt
models/all-MiniLM-L6-v2-quantized/tokenizer_config.json
*.tgz
.DS_Store
.data/
.claude/
!.claude/skills/
!.claude/skills/**
wp-plugins/advanced-custom-fields-pro
# Test database files
tests/unit/events/test-graph-*.db*
.env.e2e.local
tests/e2e/.auth/
test-results/
tests/e2e/playwright-report/
tests/e2e/.auth/
archive/
STRATEGIC_ANALYSIS.md
.worktrees
.ai.api.keys.env
docs/superpowers/
*.env.local
dev-reload.sh

# Subagent-driven-development scratch workspace (ledger, briefs, review packages)
.superpowers/

# E2E SSH fixture — generated per run, never committed
tests/e2e-cli/fixtures/ssh-host/id_ed25519
tests/e2e-cli/fixtures/ssh-host/id_ed25519.pub
tests/e2e-cli/fixtures/ssh-host/.probe_known_hosts

# Release signing keys (P0-3) — the PRIVATE key must NEVER be committed
nexus-release-signing.key
nexus-release-signing.pub

# Eval run outputs — transcripts of past agent/CLI eval runs. They are generated artifacts, not
# fixtures (nothing reads them), and carried real WPE install subdomains + a few individuals'
# emails. Never commit them (P0-2).
tests/evals/results/
