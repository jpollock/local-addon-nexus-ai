# Copy to nexus.env.local (gitignored) and fill in. dev-reload.sh passes each line to Local via
# `open --env`, which is the only way a GUI launch inherits these — a plain `export` does not
# reach an app started by `open`.
#
# From console.cloud.google.com → APIs & Services → Credentials → your OAuth client → Client secret.
# Google requires this in the authorization-code exchange for BOTH "Desktop app" and "Web
# application" client types; PKCE does not replace it. Without it every sign-in ends in
# `400 invalid_request: client_secret is missing` after the user has already consented.
NEXUS_GOOGLE_CLIENT_SECRET=

# Optional — the client id has a working default committed in ProviderRegistry.ts. Set this only
# to point at a different OAuth client.
# NEXUS_GOOGLE_CLIENT_ID=
